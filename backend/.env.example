# Copy to .env. The default (Ollama) needs NO key.

# Generation provider: "anthropic" (Claude), "ollama" (local, free), or "xai" (Grok)
LLM_PROVIDER=anthropic

# --- Anthropic Claude (used when LLM_PROVIDER=anthropic) ---
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Sonnet = best cost/quality. Use claude-opus-4-8 for max quality, claude-haiku-4-5 for cheapest.
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048

# --- Ollama (local, free; LLM_PROVIDER=ollama) ---
# Requires `ollama serve` running and `ollama pull llama3.1`.
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- xAI / Grok (LLM_PROVIDER=xai) ---
# Get a key at https://console.x.ai
XAI_API_KEY=xai-...
XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_MODEL=grok-4.3

# Embeddings run locally (no key). Any sentence-transformers model works.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Auth — set a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_DAYS=7

# OAuth (optional). Buttons appear only when a provider's id+secret are set.
# Register redirect URI: <OAUTH_REDIRECT_BASE>/api/auth/oauth/<provider>/callback
#   Google:  https://console.cloud.google.com/apis/credentials
#   GitHub:  https://github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# CORS: comma-separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

# Chunking (tokens)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
