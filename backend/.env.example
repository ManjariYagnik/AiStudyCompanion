# Copy to .env. The default (Ollama) needs NO key.

# Generation provider: "ollama" (local, free) or "xai" (Grok cloud)
LLM_PROVIDER=ollama

# --- Ollama (local, default) ---
# Requires `ollama serve` running and `ollama pull llama3.1`.
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- xAI / Grok (only used when LLM_PROVIDER=xai) ---
# Get a key at https://console.x.ai
XAI_API_KEY=xai-...
XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_MODEL=grok-4.3

# Embeddings run locally (no key). Any sentence-transformers model works.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# CORS: comma-separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

# Chunking (tokens)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
